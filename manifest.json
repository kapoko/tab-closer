{
  "manifest_version": 2,
  "name": "Tab Closer",
  "version": "1.0.0",
  "description": "Closes untouched tabs after a configurable wall-clock timeout.",
  "permissions": [
    "alarms",
    "sessions",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Tab Closer",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-closer@koman.app",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
